<?xml version="1.0" encoding="UTF-8"?>
<!-- Test suite hulu untuk integrasi Laravel (src/Laravel) jalur 1.x, setelah rename. -->
<phpunit backupStaticAttributes="false"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false"
         bootstrap="tests/Laravel/bootstrap.php">
    <testsuites>
        <testsuite name="laravel">
            <directory>./tests/Laravel/Jasnita/</directory>
        </testsuite>
    </testsuites>
</phpunit>
