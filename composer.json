{
    "name": "jasnita/monitor-laravel",
    "description": "Agent Jasnita Monitor untuk Laravel 5.x–9 (jalur 1.x): error, performa, query, dan breadcrumb ke Jasnita Monitor.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "monitoring",
        "error-tracking",
        "jasnita"
    ],
    "authors": [
        {
            "name": "Ali Syarudin",
            "email": "ali.syarudin@jasnita.com"
        }
    ],
    "require": {
        "php": "^7.2 | ^8.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/promises": "^1.5.3|^2.0",
        "http-interop/http-factory-guzzle": "^1.0",
        "illuminate/support": "5.0 - 5.8 | ^6.0 | ^7.0 | ^8.0 | ^9.0",
        "jean85/pretty-package-versions": "^1.5|^2.0.4",
        "nyholm/psr7": "^1.0",
        "php-http/async-client-implementation": "^1.0",
        "php-http/client-common": "^1.5|^2.0",
        "php-http/discovery": "^1.15",
        "php-http/httplug": "^1.1|^2.0",
        "php-http/message": "^1.5",
        "php-http/message-factory": "^1.1",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "symfony/http-client": "^4.3|^5.0|^6.0|^7.0",
        "symfony/options-resolver": "^3.4.43|^4.4.30|^5.0.11|^6.0|^7.0",
        "symfony/polyfill-php80": "^1.17",
        "symfony/psr-http-message-bridge": "^1.0 | ^2.0"
    },
    "autoload": {
        "files": [
            "src/Sdk/functions.php"
        ],
        "psr-4": {
            "Jasnita\\Monitor\\Sdk\\": "src/Sdk/",
            "Jasnita\\Monitor\\Laravel\\": "src/Laravel/",
            "Jasnita\\Monitor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jasnita\\Monitor\\MonitorServiceProvider"
            ],
            "aliases": {
                "Monitor": "Jasnita\\Monitor\\Facades\\Monitor"
            }
        }
    },
    "support": {
        "issues": "https://github.com/alisyarudin/sdk-monitor-laravel/issues",
        "source": "https://github.com/alisyarudin/sdk-monitor-laravel"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "http-interop/http-factory-guzzle": "^1.0",
        "laravel/framework": "5.0 - 5.8 | ^6.0 | ^7.0 | ^8.0 | ^9.0",
        "mockery/mockery": "^1.3",
        "monolog/monolog": "^1.6|^2.0|^3.0",
        "orchestra/testbench": "3.1 - 3.8 | ^4.7 | ^5.1 | ^6.0 | ^7.0",
        "phpunit/phpunit": "^5.7 | ^6.5 | ^7.5 | ^8.4 | ^9.3",
        "symfony/phpunit-bridge": "^5.2|^6.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Jasnita\\Monitor\\Sdk\\Tests\\": "tests/Sdk/",
            "Jasnita\\Monitor\\Laravel\\Tests\\": "tests/Laravel/Jasnita/",
            "Jasnita\\Monitor\\Tests\\": "tests/Jasnita/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
